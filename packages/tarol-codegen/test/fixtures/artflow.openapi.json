  "components": {
    "schemas": {
      "AuctionRow": {
        "required": ["id", "seller", "reserve", "highestBid", "bids", "settled", "paid", "openedAt"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "seller": {
            "type": "string"
          },
          "reserve": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "highestBid": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "bids": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "settled": {
            "type": "boolean"
          },
          "paid": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "openedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AuctionView": {
        "required": ["id", "seller", "reserve", "bids", "settled", "paid"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "seller": {
            "type": "string"
          },
          "reserve": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          },
          "bids": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": ["integer", "string"],
            "format": "int32"
          },
          "settled": {
            "type": "boolean"
          },
          "paid": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          }
        }
      },
      "CreateAuction": {
        "required": ["reserve"],
        "type": "object",
        "properties": {
          "reserve": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          }
        }
      },
      "PlaceBid": {
        "required": ["amount"],
        "type": "object",
        "properties": {
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": ["number", "string"],
            "format": "double"
          }
        }
      },
      "SettleAuction": {
        "type": "object"
      }
    }
