            "type": [
              "null",
              "integer"
            ],
            "format": "int64"
          }
        }
      },
      "DeadLetterView": {
        "required": [
          "id",
          "kind",
          "name",
          "tenant",
          "subject",
          "attempts",
          "error",
          "deadAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "tenant": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "subject": {
            "type": "string"
          },
          "attempts": {
            "type": "integer",
            "format": "int32"
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          },
          "deadAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErasureView": {
        "required": [
          "tenant",
          "subject",
          "alreadyErased",
          "streams"
        ],
        "type": "object",
        "properties": {
          "tenant": {
            "type": "string",
            "format": "uuid"
          },
          "subject": {
            "type": "string",
            "format": "uuid"
          },
          "alreadyErased": {
            "type": "boolean"
          },
          "streams": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProjectionVersion": {
        "required": [
          "name",
          "version",
          "state",
          "rows",
          "bytes",
          "superseded"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int32"
          },
          "state": {
            "type": "string"
          },
          "rows": {
            "type": "integer",
            "format": "int64"
          },
          "bytes": {
            "type": "integer",
            "format": "int64"
          },
          "superseded": {
            "type": "boolean"
          }
        }
