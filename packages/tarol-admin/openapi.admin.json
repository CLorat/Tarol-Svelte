          },
          "errorDetails": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "required": [
                  "code"
                ],
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "detail": {
                    "type": "string"
                  }
                }
              }
            },
            "description": "Per JSON path of the input: each error's code and the rule's detail (e.g. the bounds 3..60)"
          }
        },
        "description": "RFC 9457 problem details: code for an error, errors for invalid input"
      }
    }
  }
