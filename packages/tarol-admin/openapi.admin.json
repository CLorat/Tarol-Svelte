            "type": "integer",
            "format": "int32"
          }
        }
      },
      "TarolProblem": {
        "required": [
          "type",
          "status",
          "title"
        ],
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "The RFC 9110 section of the status"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string",
            "description": "The code, or \"One or more fields are invalid.\""
          },
          "code": {
            "type": "string",
            "description": "The error's code (e.g. Auction.NotOpen); absent for invalid input"
          },
          "detail": {
            "type": "string"
          },
          "traceId": {
            "type": "string",
            "description": "The request's id, also its Tarol-Request-Id header: quote it when reporting the problem"
